# Kopiere diese Datei nach .env und trage den Schlüssel ein.
ANTHROPIC_API_KEY=
# Zugangscode, den die App beim ersten Öffnen abfragt. Bei Zugriff über das Internet unbedingt setzen.
ACCESS_TOKEN=
# marktguru (Standard) oder sample (Beispielangebote für Tests ohne Netz)
OFFERS_PROVIDER=marktguru
# Optional
# Zusätzliche Suchbegriffe für Angebote, kommagetrennt
# OFFER_QUERIES_EXTRA=hirse,ziegenkäse,tempeh
# ANTHROPIC_MODEL=claude-sonnet-5
# PORT=3000
# HOST=127.0.0.1
